# ===== 五子棋独立版（gomoku）=====
# 只提交 Python 引擎/独立版源码；插件 JS 层仅本地保留；训练数据、实验产物、依赖不入库。

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/

# IDE
.idea/

# 插件 Node 层（仅本地使用，不进本仓库）
lib/
package.json
package-lock.json
node_modules/

# 插件遗留会话文件
.dsh-requirements.session-*.json
.dsh-versions.session-*.json

# 根目录空数据目录
/data/

# 训练/标注数据（体积大，不入库）
katago_data/
gomoku/data/nn_samples*.json
gomoku/data/nn_samples*.npz
gomoku/data/human_annotations.json
gomoku/data/eval_rl50.log

# GA 进化检查点（只保留运行时 ga_best_params.json）
gomoku/data/ga_ckpt.json
gomoku/data/ga_deep_*.json

# 模型权重（训练产物，不提交；引擎无权重时自动回退纯算法）
gomoku/nn/*.pt

# 本地存储
storages/

gomoku/data/*.jsonl
gomoku/data/ga_ckpt_v2.json
gomoku/data/ga_deep_ckpt.json
gomoku/data/ga_best_params_old.json

